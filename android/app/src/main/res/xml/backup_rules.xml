<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower (android:fullBackupContent). The manifest already sets
    allowBackup="false", which on these versions disables Auto Backup and
    device transfer outright; these rules keep the encrypted Hive boxes
    (app_flutter/, domain "root") and the secure-storage prefs that hold their
    key (shared_prefs/FlutterSecureStorage.xml) out of any backup even if that
    flag is ever flipped. See data_extraction_rules.xml for the reasoning.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
    <exclude domain="device_root" path="." />
</full-backup-content>
